cabal-version: 3.0
name:            myapp-ui
version:         0.1.0.0
license:         NONE
build-type:      Simple

executable myapp-ui
  main-is:         Main.hs
  hs-source-dirs:  app
  other-modules:
      MyApp.UI.App
  default-language: Haskell2010
  build-depends:
      base < 5
    , myapp-api
  ghc-options:     -Wall -O2

  if arch(wasm32)
    build-depends:
        miso >= 1.9
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options: -DWASM
    buildable: True
  else
    buildable: False
