cabal-version: 3.0
name:            myapp-server
version:         0.1.0.0
license:         NONE
build-type:      Simple

library
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:
    MyApp.Server
  build-depends:
      aeson
    , base
    , myapp-api
    , servant-server
    , stm
    , text
    , wai
    , wai-app-static
    , wai-cors
    , warp
  ghc-options: -Wall

executable myapp-server
  main-is:         Main.hs
  hs-source-dirs:  app
  default-language: Haskell2010
  build-depends:
      base
    , myapp-server
  ghc-options:     -Wall -threaded -rtsopts
